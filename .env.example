# ============================================================================
# Smart City Cluj-Napoca — Environment Configuration Template (Anul 2026)
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to version control.
# ============================================================================

# Database Persistence Engine Route (Unified Local Storage Target)
DATABASE_PATH=app.db

# Generative AI Platform (Groq LLM Assistant Infrastructure)
# Replace with your actual secure Groq Cloud API provider token
GROQ_API_KEY=your_groq_api_key_here

# Operational Operator Security & Authentication Gateways
# Explicit values mapped strictly to prevent hardcoded identity injection
PLATFORM_ADMIN_USER=your_secure_admin_username_here
PLATFORM_ADMIN_PASS=your_strong_cryptographic_password_here
